# Copy to backend/.env and fill in only what you use. Never commit .env.
JARVIS_ENVIRONMENT=dev
JARVIS_DATA_DIR=./data

# 32-byte key, base64-encoded. If omitted, JARVIS generates data/master.key on first run.
# Generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
JARVIS_MASTER_KEY=

# LLM provider: ollama (default, local) or anthropic (cloud, requires key).
JARVIS_LLM_PROVIDER=ollama
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen3.5:2b
JARVIS_OLLAMA_EMBED_MODEL=nomic-embed-text
# Disable thinking traces for thinking-capable models. Set true only if you want them.
JARVIS_OLLAMA_THINK=false
JARVIS_ALLOW_CLOUD=false

# Cloud provider (only used when JARVIS_LLM_PROVIDER=anthropic and ALLOW_CLOUD=true).
JARVIS_ANTHROPIC_API_KEY=
JARVIS_ANTHROPIC_MODEL=claude-sonnet-4-5

# API. Binds loopback by default. Set a token before exposing through any tunnel.
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8766
JARVIS_API_TOKEN=
JARVIS_CORS_ORIGINS=
# Requests per minute per client IP. 0 disables the limiter.
JARVIS_RATE_LIMIT_PER_MINUTE=120

# Agent limits.
JARVIS_MAX_PLAN_STEPS=12
JARVIS_MAX_REPLANS=2
JARVIS_TOOL_TIMEOUT_S=30
JARVIS_LOG_LEVEL=INFO

# Per-tool permission overrides, JSON object. Values: read_only | confirm | autonomous.
# JARVIS_TOOL_PERMISSIONS={"memory.forget":"confirm","time.now":"read_only"}
JARVIS_TOOL_PERMISSIONS={}

# Skills. Empty means ./skills next to the backend package.
JARVIS_SKILLS_DIR=
# Brave Search API key for web.search. Get one at https://brave.com/search/api/
JARVIS_BRAVE_API_KEY=
JARVIS_WEB_SEARCH_RESULTS=5
JARVIS_WEB_READ_MAX_BYTES=1000000
JARVIS_WEB_READ_MAX_CHARS=20000
JARVIS_WEB_READ_TIMEOUT_S=15

# files.search roots: comma-separated paths or a JSON array. Empty uses
# Desktop, Documents, and Downloads under your home directory.
JARVIS_FILE_SEARCH_ROOTS=
JARVIS_FILE_SEARCH_MAX_RESULTS=20
JARVIS_FILE_SEARCH_MAX_ENTRIES=20000
