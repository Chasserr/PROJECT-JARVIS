# Copy this file to backend/.env. Never commit the real .env file.
# Cloud inference is disabled by default; JARVIS stays local until explicitly enabled.
JARVIS_PROVIDER=claude
JARVIS_CLOUD_ENABLED=false
JARVIS_CLAUDE_API_KEY=
JARVIS_CLAUDE_MODEL=claude-sonnet-4-5

# Local OpenAI-compatible provider. LM Studio default:
JARVIS_LOCAL_BASE_URL=http://127.0.0.1:1234/v1
JARVIS_LOCAL_API_KEY=lm-studio
JARVIS_LOCAL_MODEL=google/gemma-4-e2b

# To use Ollama as the local fallback instead, set:
# JARVIS_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# JARVIS_LOCAL_API_KEY=ollama
# JARVIS_LOCAL_MODEL=<your-installed-model>

JARVIS_MAX_AGENT_STEPS=8
JARVIS_MAX_RETRIES_PER_STEP=1
JARVIS_KILL_SWITCH=false
