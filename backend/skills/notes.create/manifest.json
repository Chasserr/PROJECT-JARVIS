{
  "version": "1.0.0",
  "name": "notes.create",
  "description": "Create an encrypted note with an optional title and tags.",
  "permission": "autonomous",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "maxLength": 200
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20000
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 40
        },
        "maxItems": 20
      }
    },
    "required": [
      "body"
    ],
    "additionalProperties": false
  },
  "tags": [
    "notes"
  ]
}
