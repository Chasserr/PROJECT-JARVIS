{
  "version": "1.0.0",
  "name": "reminders.delete",
  "description": "Delete a reminder. Soft delete by default; hard=true is irreversible.",
  "permission": "confirm",
  "input_schema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "hard": {
        "type": "boolean"
      }
    },
    "required": [
      "id"
    ],
    "additionalProperties": false
  },
  "tags": [
    "reminders",
    "destructive"
  ],
  "dangerous": true
}
