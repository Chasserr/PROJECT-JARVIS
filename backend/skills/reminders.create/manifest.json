{
  "version": "1.0.0",
  "name": "reminders.create",
  "description": "Create an encrypted reminder with an optional Unix due time.",
  "permission": "autonomous",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "due_at": {
        "type": "number"
      }
    },
    "required": [
      "text"
    ],
    "additionalProperties": false
  },
  "tags": [
    "reminders"
  ]
}
