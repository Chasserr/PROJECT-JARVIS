{
  "version": "1.0.0",
  "name": "reminders.list",
  "description": "List reminders, optionally filtered by pending or done status.",
  "permission": "read_only",
  "input_schema": {
    "type": "object",
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "pending",
          "done"
        ]
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100
      }
    },
    "required": [],
    "additionalProperties": false
  },
  "tags": [
    "reminders"
  ]
}
